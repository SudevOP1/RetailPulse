# Copy to %USERPROFILE%\.dbt\profiles.yml (never commit the real one).
# Credentials come from the PG* env vars: load them first with  . .\scripts\env.ps1
retailpulse:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('PGHOST', 'localhost') }}"
      port: "{{ env_var('PGPORT', '5432') | as_number }}"
      dbname: "{{ env_var('PGDATABASE', 'retailpulse') }}"
      user: "{{ env_var('PGUSER', 'rp_user') }}"
      password: "{{ env_var('PGPASSWORD') }}"
      schema: dev
      threads: 4
      connect_timeout: 10
